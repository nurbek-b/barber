# Non-secret deployment settings for Firebase Hosting + Cloud Run (committed to git).
# Secrets live in Secret Manager — see setup.sh.
PROJECT_ID=britva-barber
# Frankfurt: create Neon (aws-eu-central-1) and Upstash (eu-central-1) in the same city.
# Must match "region" in firebase.json rewrites.
REGION=europe-west3
SITE_URL=https://britva-barber.web.app
REPO=barber
MEDIA_BUCKET=britva-barber-media
# Telegram bot username without @ (public, not a secret)
BOT_USERNAME=
# 0 = scale to zero (cheapest, ~2-4 s cold start); 1 = always warm (~$10-15/month)
API_MIN_INSTANCES=0
