# Copy to .env and fill in. Never commit real values.
ENV=dev
LOG_LEVEL=INFO
LOG_JSON=false

DATABASE_URL=postgresql+asyncpg://barber:CHANGE_ME@localhost:5432/barber
REDIS_URL=redis://localhost:6379/0

# Telegram (@BotFather)
BOT_TOKEN=
BOT_USERNAME=
MINIAPP_SHORT_NAME=app
# Public https URL of the Mini App, e.g. https://example.com/app/
MINIAPP_URL=
WEBHOOK_SECRET=
INIT_DATA_TTL_SECONDS=86400

# Admin auth: at least 32 random chars, e.g. `openssl rand -hex 32`
JWT_SECRET=
COOKIE_SECURE=true
COOKIE_DOMAIN=

# Comma-separated, e.g. https://admin.example.com
CORS_ORIGINS=
PUBLIC_BASE_URL=http://localhost:8000
MEDIA_DIR=./media

SENTRY_DSN=
