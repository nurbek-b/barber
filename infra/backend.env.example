# Copy to /opt/barber/backend.env on the server (chmod 600). Fill every empty value.
ENV=production
LOG_LEVEL=INFO
LOG_JSON=true

BOT_TOKEN=
BOT_USERNAME=
MINIAPP_SHORT_NAME=app
MINIAPP_URL=https://barber.example.com/app/
WEBHOOK_SECRET=
INIT_DATA_TTL_SECONDS=86400

# openssl rand -hex 32
JWT_SECRET=
COOKIE_SECURE=true
# Mini App and admin are served from the same origin as the API: CORS is not needed.
CORS_ORIGINS=
PUBLIC_BASE_URL=https://barber.example.com

SENTRY_DSN=
